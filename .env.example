APP_NAME=Realize
PUBLIC_BASE_URL=http://localhost:3000
DOMAIN=
DEBUG_ENDPOINTS=false

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=realize

GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash
GEMINI_MODEL_VIDEO=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Optional, comma separated. Tried in order when the model above answers 429 or 503.
# Free-tier keys have a small daily quota per model. Never list a Lite model for FAST.
GEMINI_MODEL_FAST_FALLBACKS=
GEMINI_MODEL_VIDEO_FALLBACKS=

INSTAGRAM_COOKIES_PATH=

PLANNER_MODE=live
PROPOSAL_WAIT_SECONDS=20
HYBRID_MODE=auto
WORKER_ID=laptop
WORKER_PROPOSE_THREADS=2
WORKER_ENRICH_THREADS=2
DEFAULT_TIMEZONE=America/New_York

SHORTCUT_URL=
JUDGE_SHORTCUT_URL=
FIRST_SAVE_REEL_URL=
DEMO_ENABLED=true
