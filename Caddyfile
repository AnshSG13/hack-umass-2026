{
	# HTTP/3 (QUIC) off: the iOS Shortcuts runner drops HTTP/3 connections
	# with "The network connection was lost"; h1/h2 work everywhere.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {$EXTRA_DOMAINS} {
	log {
		output stdout
		format console
	}
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
