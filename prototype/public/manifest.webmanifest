{
  "name": "Second Brain",
  "short_name": "Brain",
  "description": "Save Instagram reels to your second brain.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F6F7FB",
  "theme_color": "#2F5BFF",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
